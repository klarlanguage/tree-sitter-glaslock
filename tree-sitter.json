{
    "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
    "grammars": [
        {
            "name": "glaslock",
            "camelcase": "GlasLock",
            "title": "glas.lock",
            "scope": "source.glaslock",
            "file-types": ["glas.lock"],
            "injection-regex": "^(?:glaslock|glas\\.lock)$",
            "class-name": "TreeSitterGlasLock",
            "first-line-regex": "",
            "highlights": "queries/highlights.scm",
            "locals": "queries/locals.scm"
        }
    ],
    "metadata": {
        "version": "0.1.0",
        "license": "MIT",
        "description": "glas.lock grammar for tree-sitter",
        "authors": [
            { "name": "ProCode Software", "url": "https://github.com/ProCode-Software" }
        ],
        "links": {
            "repository": "https://github.com/tree-sitter/tree-sitter-glaslock",
            "funding": ""
        }
    },

    "bindings": {
        "c": true,
        "go": false,
        "java": false,
        "node": true,
        "python": false,
        "rust": true,
        "swift": false,
        "zig": false
    }
}
